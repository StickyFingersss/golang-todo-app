                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/github_com_StickyFingersss_golang-todo-app_internal_core_transport_http_response.ErrorResponse"
                        }
                    }
                }
            }
        },
